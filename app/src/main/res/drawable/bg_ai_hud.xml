<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow border simulation -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_cyan_glow" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_card_bg_elevated" />
            <stroke
                android:width="1.5dp"
                android:color="@color/neon_cyan" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
